"
.accounts-user-management-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: 28px;
}


.accounts-user-management-header-left {
    display: flex;
    align-items: center;
    gap: 16px;
}


.accounts-user-management-header-icon {
    width: 56px;
    height: 56px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f1f5f9;
    color: #334155;
    flex-shrink: 0;
}


/* .accounts-user-management-breadcrumb {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 5px;
    font-size: 13px;
    color: #64748b;
}


.accounts-user-management-breadcrumb span {
    color: #94a3b8;
} */


.accounts-user-management-header h1 {
    margin: 0;
    font-size: 27px;
    font-weight: 700;
    color: #0f172a;
}


.accounts-user-management-header p {
    margin: 5px 0 0;
    color: #64748b;
    font-size: 14px;
}


/* ============================================================
   ADD USER BUTTON
   ============================================================ */

.accounts-user-management-add-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 11px 17px;
    border: none;
    border-radius: 9px;
    background: #20bcb9;
    color: #ffffff;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition:
        background 0.2s ease,
        transform 0.2s ease,
        box-shadow 0.2s ease;
}


.accounts-user-management-add-btn:hover {
    background: #18a7a5;
    transform: translateY(-1px);
    box-shadow:
        0 5px 14px rgba(32, 188, 185, 0.22);
}"